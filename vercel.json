{
  "git": {
    "deploymentEnabled": {
      "codex/iphone-client-and-navigation": false,
      "codex/sticker-first-redesign": false,
      "codex/open-admin-dashboard": false,
      "codex/android-favorites": false,
      "codex/received-motion": false,
      "codex/iphone-photo-archives": false
    }
  },
  "rewrites": [
    {"source": "/studio", "destination": "/studio/index.html"},
    {"source": "/account", "destination": "/site/account.html"},
    {"source": "/admin", "destination": "/admin/index.html"},
    {"source": "/admin/", "destination": "/admin/index.html"},
    {"source": "/privacy", "destination": "/studio/privacy.html"},
    {"source": "/about", "destination": "/site/about.html"},
    {"source": "/support", "destination": "/site/support.html"},
    {"source": "/", "destination": "/admin/index.html"}
  ],
  "redirects": [
    {"source": "/download", "destination": "https://github.com/dvajjala-ui/stickerdock/releases/latest/download/StickerDock.apk", "permanent": false}
  ],
  "functions": {
    "api/ingest.py": {"includeFiles": "tools/**"},
    "api/account.py": {"includeFiles": "tools/**"},
    "api/cloud.py": {"includeFiles": "tools/**"},
    "api/personal_ai.py": {"includeFiles": "tools/**"},
    "api/admin.py": {"includeFiles": "tools/**"},
    "api/pinterest_callback.py": {"includeFiles": "tools/**"}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Cross-Origin-Resource-Policy", "value": "same-origin"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ]
}
